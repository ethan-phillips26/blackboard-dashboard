# Your school's Blackboard hostname. Any of these forms work:
#   blackboard.university.edu
#   https://blackboard.university.edu
#   https://blackboard.university.edu/ultra/course  (trimmed to the origin)
BB_HOST=blackboard.university.edu

# Your logged-in browser session cookie. See README "Getting your cookie".
# Paste the entire Cookie request header; the server keeps what it needs.
BB_COOKIE=BbRouter=expires:...,id:...,signature:...

# Your SSO credentials. Only `uv run blackboard-login` reads these: it drives a
# headless browser through the login so you never have to copy a cookie by hand.
BB_USERNAME=your.ndus.id
BB_PASSWORD=

# Where downloaded assignment files go. Optional; defaults to a
# `blackboard-files` folder inside the state directory (see BB_STATE_DIR).
BB_DOWNLOAD_DIR=./blackboard-files

# Where .env, the session cookie, the browser profile and the caches live.
# Optional. Defaults to this source directory when a .env is already sitting in
# it, and otherwise to the per-user data directory:
#   Linux    ~/.local/share/blackboard
#   macOS    ~/Library/Application Support/blackboard
#   Windows  %APPDATA%\blackboard
# Set this when running from a packaged build or under Electron, where neither
# the source tree nor the working directory is a safe place to keep state.
# BB_STATE_DIR=

# How often to ping Blackboard to keep the session from idling out, in minutes.
# The idle timeout is typically 180 min, so 45 leaves plenty of headroom.
# Set to 0 to disable.
BB_KEEPALIVE_MINUTES=45

# Where the auto-renewed session cookie is cached. Optional;
# defaults to .bb_session.json next to this file.
# BB_SESSION_FILE=./.bb_session.json

# --- Which model reads syllabi and writes the briefing ---
# `claude` (default) shells out to the `claude` CLI. `ollama` talks to a model
# served locally on this machine, so nothing leaves it and no API key is needed.
# Only three things use a model at all: extracting a syllabus's grade weighting,
# sorting gradebook rows into it, and writing the weekly briefing. Every
# percentage on screen is computed locally either way.
# BB_LLM=ollama

# The local model to use, and where Ollama is listening. `ollama pull qwen3:8b`
# first. An 8B model is comfortable at sorting gradebook rows and adequate at
# reading a syllabus; expect to fix more mappings by hand than with Claude.
# BB_OLLAMA_MODEL=qwen3:8b
# BB_OLLAMA_URL=http://127.0.0.1:11434

# Context window for the local model. Ollama truncates silently past this rather
# than failing, and a syllabus that loses its grade table yields a confident
# empty answer, so this is deliberately generous. Lower it if you are short on
# VRAM, and lower BB_LLM_DOC_CHARS to match.
# BB_OLLAMA_CTX=32768

# How much of a syllabus to send, in characters, and how long to wait for a
# reply. Both default by backend: 24000/600s for ollama, 60000/240s for claude.
# BB_LLM_DOC_CHARS=24000
# BB_LLM_TIMEOUT=600

# --- Opening handouts in Google Docs (optional) ---
# Needed only for the "Open in Docs" button. Create a Google Cloud project,
# enable the Drive API, and make an OAuth client of type "Desktop app".
# The scope used is drive.file: this app can only touch files it creates itself,
# never anything already in your Drive.
BB_GOOGLE_CLIENT_ID=
BB_GOOGLE_CLIENT_SECRET=

# Which browser to open the resulting doc in. Defaults to librewolf, then
# firefox, then xdg-open.
# BB_BROWSER=librewolf

# Where the Google refresh token is cached. Optional;
# defaults to .bb_google.json next to this file.
# BB_GOOGLE_TOKEN_FILE=./.bb_google.json
